# Copy this file to .env for local server configuration.
PORT=3001
# Set only in your local .env or hosting server environment. Required for generation.
# Never prefix this with VITE_ or commit a real key. Health works without a key.
OPENAI_API_KEY=
# Keep 0 locally. Set to the verified proxy hop count on your hosting provider.
TRUST_PROXY_HOPS=0
